<Page x:Class="Практика_5.GroupFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="900"
      Background="White"
      Title="Группа">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="Группа"
                   FontSize="20"
                   FontWeight="Bold"/>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="ID" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Margin="5,8,5,8"
                       Text="{Binding Id}"
                       VerticalAlignment="Center"/>

            <Label Grid.Row="1" Content="Название" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="5"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="2" Content="Специальность" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="5"
                     Text="{Binding Speciality, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="3" Content="Курс" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="5"
                     Text="{Binding Course, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Студенты группы"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>

            <Button Content="Добавить студента"
                    Margin="0,0,10,0" Padding="5"
                    Click="AddStudent_Click"/>
            <Button Content="Изменить"
                    Margin="0,0,10,0" Padding="5"
                    Click="EditStudent_Click"/>
            <Button Content="Удалить"
                    Margin="0,0,10,0" Padding="5"
                    Click="DeleteStudent_Click"/>

            <TextBlock Text="{Binding GroupAverageGrade, StringFormat='Средний балл группы: {0:F2}'}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       FontWeight="Bold"/>
        </StackPanel>

        <ListView Grid.Row="3"
                  x:Name="StudentsList"
                  Margin="0,10,0,10"
                  ItemsSource="{Binding Students}"
                  MouseDoubleClick="EditStudent_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                        <StackPanel>
                            <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Age, StringFormat='Возраст: {0}'}"/>
                            <TextBlock Text="{Binding AverageGrade, StringFormat='Средний балл: {0:F2}'}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="Сохранить"
                    Width="120" Margin="0,0,10,0" Padding="5"
                    Click="SaveButton_Click"/>
            <Button Content="Назад"
                    Width="120" Padding="5"
                    Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
