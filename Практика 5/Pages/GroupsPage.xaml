<Page x:Class="Практика_5.GroupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="900"
      Background="White"
      Title="Учебные группы">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="Добавить"
                    Width="110" Margin="0,0,10,0" Padding="5"
                    Click="AddButton_Click"/>
            <Button Content="Удалить"
                    Width="110" Margin="0,0,10,0" Padding="5"
                    Click="DeleteButton_Click"/>
            <Button Content="Сохранить в JSON"
                    Width="150" Margin="0,0,10,0" Padding="5"
                    Click="SaveButton_Click"/>
            <TextBlock Text="Двойной щелчок по группе - редактирование"
                       VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <ListView Grid.Row="1"
                  Margin="0,10,0,10"
                  ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                  MouseDoubleClick="EditItem_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Speciality, StringFormat='Специальность: {0}'}"/>
                            <TextBlock Text="{Binding Course, StringFormat='Курс: {0}'}"/>
                            <TextBlock Text="{Binding Students.Count, StringFormat='Студентов: {0}'}"/>
                            <TextBlock Text="{Binding GroupAverageGrade, StringFormat='Средний балл группы: {0:F2}'}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Background="AntiqueWhite">
            <Label Content="Всего групп:"/>
            <Label Content="{Binding Groups.Count}"/>
        </StackPanel>
    </Grid>
</Page>
